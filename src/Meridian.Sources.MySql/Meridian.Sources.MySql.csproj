<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <Description>Meridian IPointSource over MySQL 8: long or wide tables and views, with calendar bucketing and the standard aggregators pushed down into SQL, exactly.</Description>
    <PackageTags>$(PackageTags);mysql</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meridian.Sources.Sql/Meridian.Sources.Sql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
</Project>
