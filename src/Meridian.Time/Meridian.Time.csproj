<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Time for longitudinal reporting: IANA time zones (NodaTime), calendars and seasons, day/week/month/sub-daily buckets, gap policies, DST-safe resampling, and how stored timestamps are read.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meridian.Core/Meridian.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundled IANA tz database: identical zone rules on every OS, no ICU/globalization dependency. -->
    <PackageReference Include="NodaTime" Version="3.3.4" />
  </ItemGroup>
</Project>
