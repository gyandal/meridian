  <ItemGroup>
    <ProjectReference Include="../Meridian.Core/Meridian.Core.csproj" />
    <ProjectReference Include="../Meridian.Time/Meridian.Time.csproj" />
    <ProjectReference Include="../Meridian.Caching/Meridian.Caching.csproj" />
    <ProjectReference Include="../Meridian.Semantics/Meridian.Semantics.csproj" />
    <ProjectReference Include="../Meridian.Engine/Meridian.Engine.csproj" />
  </ItemGroup>
</Project>
