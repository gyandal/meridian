<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <Description>Meridian IPointSource over ClickHouse: long or wide tables and views, with calendar bucketing and every built-in aggregator pushed down into SQL, exactly.</Description>
    <PackageTags>$(PackageTags);clickhouse</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Meridian.Sources.Sql/Meridian.Sources.Sql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.5.0" />
  </ItemGroup>
</Project>
