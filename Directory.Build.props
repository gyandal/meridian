<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Package metadata. Release builds override Version from the git tag (see .github/workflows/release.yml). -->
  <PropertyGroup>
    <Version>0.1.0-dev</Version>
    <Authors>Stephen Wood</Authors>
    <Copyright>Copyright (c) 2026 Stephen Wood</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Meridian: embeddable, time-correct reporting over your own data — metrics, transforms, caching and chart-agnostic views for .NET.</Description>
    <PackageTags>analytics;reporting;time-series;longitudinal;metrics;semantic-layer;duckdb;timezone</PackageTags>
    <PackageProjectUrl>https://github.com/gyandal/meridian</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gyandal/meridian</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/gyandal/meridian/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/nuget/README.md" Pack="true" PackagePath="\" Visible="false" Condition="'$(IsPackable)' == 'true'" />
  </ItemGroup>
</Project>
