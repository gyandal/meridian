<Project Sdk="Microsoft.NET.Sdk">

  <!-- Parity tests for every database source, against real databases in containers (Testcontainers). Where Docker
       isn't available — the Windows CI runner, a machine without it — the tests are skipped, not failed. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(SupportedTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Microsoft.Data.SqlClient doesn't support globalization-invariant mode, which the repo enables by default. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Meridian.Sources.PostgreSql\Meridian.Sources.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Sources.SqlServer\Meridian.Sources.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Sources.DuckDb\Meridian.Sources.DuckDb.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Transforms\Meridian.Transforms.csproj" />
    <ProjectReference Include="..\..\src\Meridian.Views\Meridian.Views.csproj" />
    <ProjectReference Include="..\Meridian.Sources.TestData\Meridian.Sources.TestData.csproj" />
  </ItemGroup>

</Project>
